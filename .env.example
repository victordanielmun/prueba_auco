# --- API ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Seguridad ---
# En producción: mínimo 32 caracteres, generado aleatoriamente.
JWT_SECRET=change-me-with-a-long-random-secret-of-32-chars-min
JWT_EXPIRES_IN=1h
BODY_LIMIT=10kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=validation_service
MONGO_COLLECTION=validations

# --- DynamoDB Local ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DYNAMO_ENDPOINT=http://localhost:8000
DYNAMO_AUDIT_TABLE=validation_audit_events

# --- APICountries ---
COUNTRIES_API_URL=https://apicountries.com
COUNTRIES_TIMEOUT_MS=3000
COUNTRIES_CACHE_TTL_MS=3600000
